# Copy this file to .env and fill in your keys, then run:  npm run doctor
# ProofPay talks to real services. Without keys it tells you what is missing.

# --- AI provider -------------------------------------------------------------
# Pick one. If both keys are set, NVIDIA is used unless AI_PROVIDER says otherwise.
# AI_PROVIDER=nvidia        # nvidia | claude

# NVIDIA (free): https://build.nvidia.com -> sign in -> any model page -> "Get API Key" (starts with nvapi-)
NVIDIA_API_KEY=
# Run "npm run models" to test which models work with your key, then set:
# NVIDIA_TEXT_MODEL=deepseek-ai/deepseek-v4.1-flash
# NVIDIA_VISION_MODEL=meta/muse-glimmer-30b

# Claude: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_EFFORT=medium          # low | medium | high

# --- PayPal (sandbox) --------------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox -> your app -> Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Release policy ----------------------------------------------------------
# The AI must be at least this confident before money moves without a human.
AUTO_RELEASE_CONFIDENCE=0.8

# --- Offline practice only ----------------------------------------------------
# true = fake PayPal and template AI when keys are missing. Keep false for the real thing.
SIMULATION_MODE=false

# PORT=3000
